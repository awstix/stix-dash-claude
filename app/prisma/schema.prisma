generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ProjectStatus {
  NOT_STARTED
  ACTIVE
  PAUSED
  FINISHED
  CANCELLED
}

model CompanyInfo {
  id String @id @default("default")

  companyName      String
  legalName        String?
  street           String?
  postalCode       String?
  city             String?
  country          String?
  phone            String?
  mobile           String?
  email            String?
  website          String?
  instagramUrl     String?
  linkedinUrl      String?
  facebookUrl      String?
  youtubeUrl       String?
  tiktokUrl        String?
  managingDirector String?
  registryCourt    String?
  registryNumber   String?
  vatId            String?
  taxNumber        String?
  logoPublicUrl    String?
  logoStoragePath  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeTrackingSettings {
  id String @id @default("default")

  reminderEnabled       Boolean   @default(false)
  reminderWeekdaysJson  String    @default("[]")
  reminderIntervalWeeks Int       @default(1)
  lastReminderRunAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DispositionCategoryCredit {
  id String @id @default(cuid())

  typeValue     String @unique
  creditedHours Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id                        String        @id @default(cuid())
  projectNumber             String        @unique
  name                      String
  client                    String?
  constructionManager       String?
  constructionManagersJson  String?
  plannedStart              DateTime?
  plannedEnd                DateTime?
  actualStart               DateTime?
  actualEnd                 DateTime?
  remainingConstructionTime String?
  status                    ProjectStatus @default(NOT_STARTED)

  dvgw                 Boolean @default(false)
  guetezeichenKanalbau Boolean @default(false)
  lieferscheine        Boolean @default(false)

  contractValueNet Int   @default(0)
  changeOrdersNet  Int   @default(0)
  progressPercent  Float @default(0)
  paymentsNet      Int   @default(0)

  finalInvoiceCreated Boolean @default(false)
  finalInvoiceNumber  String?
  finalInvoiceNet     Int?

  siteAddress         String?
  mapLatitude         Float?
  mapLongitude        Float?
  mapZoom             Int?
  siteBoundaryGeoJson String?

  notes String?

  autoApproveTimeEntriesOverride  Boolean?
  timeReminderEnabledOverride     Boolean?
  timeReminderWeekdaysJson        String?
  timeReminderIntervalWeeks       Int?
  timeReminderExtraRecipientsJson String?

  asphaltDispatchEntries            AsphaltDispatchEntry[]
  truckLongHaulEntries              TruckLongHaulEntry[]
  shortHaulAssignments              ShortHaulAssignment[]
  shortHaulTours                    ShortHaulTour[]
  asphaltLoadAllocations            AsphaltLoadAllocation[]
  tackCoatLoadAllocations           TackCoatLoadAllocation[]
  specialVehicleDispatchAssignments SpecialVehicleDispatchAssignment[]
  crewPlanningRows                  CrewPlanningRow[]
  equipmentDispatchAssignments      EquipmentDispatchAssignment[]
  weatherLogs                       ProjectWeatherLog[]
  dailyReports                      ProjectDailyReport[]
  photos                            ProjectPhoto[]
  projectNotes                      ProjectNote[]
  documentFolders                   ProjectDocumentFolder[]
  documents                         ProjectDocument[]
  formSubmissions                   ProjectFormSubmission[]
  inventoryAssignments              InventoryItem[]                    @relation("InventoryCurrentProject")
  inventoryUsageHistory             InventoryUsageHistory[]
  currentInventoryLocationAlerts    InventoryLocationAlert[]           @relation("InventoryAlertCurrentProject")
  suggestedInventoryLocationAlerts  InventoryLocationAlert[]           @relation("InventoryAlertSuggestedProject")
  performanceReports                ControllingPerformanceReport[]
  controllingDetailEntries          ControllingDetailEntry[]
  controllingHourEntries            ControllingHourEntry[]
  controllingInvoiceItems           ControllingInvoiceItem[]
  safetyAccidentReports             SafetyAccidentReport[]
  safetyInstructionRecords          SafetyInstructionRecord[]
  projectStartChecklists            ProjectStartChecklist[]
  generalRiskAssessments            GeneralRiskAssessment[]
  userAccesses                      UserProjectAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectNote {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  noteDate    DateTime  @default(now())
  noteEndDate DateTime?
  category    String    @default("GENERAL")
  title       String?
  content     String

  visibility           String  @default("INTERNAL")
  includeInDailyReport Boolean @default(true)
  createdByUserId      String?
  createdByName        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([noteDate])
  @@index([noteEndDate])
  @@index([category])
  @@index([includeInDailyReport])
  @@index([visibility])
  @@index([createdByUserId])
}

model ProjectWeatherLog {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  weatherDate DateTime
  source      String   @default("OPEN_METEO")

  tempMinC                    Float?
  tempMaxC                    Float?
  precipitationMm             Float   @default(0)
  precipitationProbabilityMax Int?
  windSpeedMaxKmh             Float?
  weatherCode                 Int?
  weatherLabel                String?
  weatherCategory             String?
  weatherCategorySource       String  @default("AUTO")

  currentTemperatureC    Float?
  currentWeatherCode     Int?
  currentWeatherLabel    String?
  currentPrecipitationMm Float?
  currentWindSpeedKmh    Float?
  observedAt             DateTime?
  hourlyJson             String?

  fetchedAt DateTime @default(now())
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, weatherDate])
  @@index([projectId])
  @@index([weatherDate])
  @@index([weatherCategory])
}

model ProjectDailyReport {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  reportDate   DateTime
  reportNumber Int?
  status       String   @default("DRAFT")
  sheetNumber  String   @default("1")

  reportProjectName   String?
  reportProjectNumber String?
  weekdayLabel        String?

  weatherTempMinC              Float?
  weatherTempMaxC              Float?
  weatherCategory              String?
  weatherSource                String                    @default("AUTO")
  weatherNotes                 String?
  workStart                    String?
  workEnd                      String?
  break1From                   String?
  break1To                     String?
  break2From                   String?
  break2To                     String?
  trafficSafetyFirstCheckTime  String?
  trafficSafetySecondCheckTime String?
  laborJson                    String?
  subcontractorJson            String?
  machinesJson                 String?
  materialJson                 String?
  otherJson                    String?
  performanceJson              String?
  siteDiscussionNotes          String?
  siteDiscussionRolesJson      String?
  siteDiscussionThirdPartyName String?
  showRealMachineNames         Boolean                   @default(false)
  photoGridLayout              String                    @default("2x4")
  contractorSignatureDataUrl   String?
  clientSignatureDataUrl       String?
  approvedFieldsJson           String?
  approvedAt                   DateTime?
  approvedByName               String?
  createdByUserId              String?
  createdByName                String?
  photos                       ProjectDailyReportPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, reportDate])
  @@index([projectId])
  @@index([reportDate])
  @@index([reportNumber])
  @@index([status])
  @@index([createdByUserId])
}

model ProjectPhoto {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fileName         String
  originalFileName String?
  publicUrl        String
  storagePath      String
  mimeType         String
  fileSizeBytes    Int
  imageWidth       Int?
  imageHeight      Int?

  notes                    String?
  metadataTaken            Boolean   @default(false)
  capturedAt               DateTime?
  cameraMake               String?
  cameraModel              String?
  gpsLatitude              Float?
  gpsLongitude             Float?
  gpsAddressLabel          String?
  gpsStreet                String?
  gpsHouseNumber           String?
  gpsPostcode              String?
  gpsCity                  String?
  gpsCountry               String?
  gpsReverseGeocodedAt     DateTime?
  gpsReverseGeocodeSource  String?
  gpsAddressJson           String?
  metadataJson             String?
  availableForDailyReports Boolean   @default(true)
  uploadedByUserId         String?
  uploadedByName           String?

  dailyReportLinks ProjectDailyReportPhoto[]

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@index([uploadedAt])
  @@index([capturedAt])
  @@index([gpsCity])
  @@index([uploadedByUserId])
  @@index([availableForDailyReports])
}

model ProjectDailyReportPhoto {
  id String @id @default(cuid())

  dailyReportId String
  dailyReport   ProjectDailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  photoId String
  photo   ProjectPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([dailyReportId, photoId])
  @@index([dailyReportId])
  @@index([photoId])
}

model ProjectDocumentFolder {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  documents ProjectDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([sortOrder])
}

model ProjectDocument {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  folderId String?
  folder   ProjectDocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  displayName      String
  fileName         String
  originalFileName String
  publicUrl        String
  storagePath      String
  mimeType         String
  fileSizeBytes    Int
  uploadedByUserId String?
  uploadedByName   String?

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@index([folderId])
  @@index([displayName])
  @@index([originalFileName])
  @@index([uploadedAt])
  @@index([uploadedByUserId])
}

model ProjectFormTemplate {
  id                  String  @id @default(cuid())
  name                String
  category            String?
  description         String?
  fieldsJson          String
  emailRecipientsJson String?
  isActive            Boolean @default(true)
  sortOrder           Int     @default(0)
  paperSize           String  @default("A4")
  paperOrientation    String  @default("PORTRAIT")

  submissions ProjectFormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
  @@index([sortOrder])
}

model ProjectFormSubmission {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  templateId String?
  template   ProjectFormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  title                String
  formDate             DateTime?
  valuesJson           String
  templateSnapshotJson String?
  status               String    @default("DRAFT")
  createdByUserId      String?
  createdByName        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([templateId])
  @@index([formDate])
  @@index([status])
  @@index([createdAt])
}

model Driver {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  shortcut  String? @unique
  phone     String?
  isActive  Boolean @default(true)
  notes     String?

  shortHaulAssignments              ShortHaulAssignment[]
  vehicleAssignments                DriverVehicleAssignment[]
  truckLongHaulTruckAssignments     TruckLongHaulTruckAssignment[]
  asphaltLoadAllocations            AsphaltLoadAllocation[]
  tackCoatLoadAllocations           TackCoatLoadAllocation[]
  specialVehicleOperatorAssignments SpecialVehicleDispatchAssignment[] @relation("SpecialVehicleOperatorDriver")

  employee Employee? @relation("EmployeeDriver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id                      String  @id @default(cuid())
  vehicleNumber           String  @unique
  licensePlate            String? @unique
  vehicleType             String
  category                String
  isSpecialVehicle        Boolean @default(false)
  isActive                Boolean @default(true)
  notes                   String?
  dailyReportMachineLabel String?

  asphaltPayloadTons Float @default(0)
  tackCoatTankLiters Float @default(0)

  shortHaulAssignments               ShortHaulAssignment[]
  driverAssignments                  DriverVehicleAssignment[]
  truckLongHaulTruckAssignments      TruckLongHaulTruckAssignment[]
  specialVehicleTasks                SpecialVehicleTask[]
  specialVehicleDispatchAssignments  SpecialVehicleDispatchAssignment[] @relation("SpecialVehicleDispatchVehicle")
  specialVehicleTransportAssignments SpecialVehicleDispatchAssignment[] @relation("SpecialVehicleTransportVehicle")
  tours                              ShortHaulTour[]
  asphaltLoadAllocations             AsphaltLoadAllocation[]
  tackCoatLoadAllocations            TackCoatLoadAllocation[]
  crewDefaultVehicles                CrewDefaultVehicle[]
  crewPlanningAssignmentVehicles     CrewPlanningAssignmentVehicle[]
  equipmentDispatchAssignments       EquipmentDispatchAssignment[]
  workshopRepairOrders               WorkshopRepairOrder[]
  workshopFormSubmissions            WorkshopFormSubmission[]
  inventoryItems                     InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dailyReportMachineLabel])
}

model WorkshopRepairOrder {
  id String @id @default(cuid())

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  vehicleNumber String?
  licensePlate  String?
  vehicleType   String?

  title       String
  description String?
  priority    String  @default("NORMAL")
  status      String  @default("OPEN")

  reportedAt      DateTime  @default(now())
  plannedStart    DateTime?
  plannedEnd      DateTime?
  completedAt     DateTime?
  completedByName String?

  assignedTo       String?
  notes            String?
  customValuesJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([priority])
  @@index([reportedAt])
  @@index([plannedStart])
  @@index([completedAt])
}

model WorkshopFormTemplate {
  id                  String  @id @default(cuid())
  name                String
  category            String?
  description         String?
  fieldsJson          String
  emailRecipientsJson String?
  isActive            Boolean @default(true)
  sortOrder           Int     @default(0)
  paperSize           String  @default("A4")
  paperOrientation    String  @default("PORTRAIT")

  submissions WorkshopFormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model WorkshopFormSubmission {
  id String @id @default(cuid())

  templateId String?
  template   WorkshopFormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  templateKind         String
  title                String
  priority             String    @default("NORMAL")
  formDate             DateTime?
  valuesJson           String
  templateSnapshotJson String?
  createdByName        String?
  completedAt          DateTime?
  completedByName      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([vehicleId])
  @@index([inventoryItemId])
  @@index([templateKind])
  @@index([priority])
  @@index([completedAt])
  @@index([formDate])
  @@index([createdAt])
}

model DriverVehicleAssignment {
  id String @id @default(cuid())

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  isPrimary Boolean @default(true)
  isActive  Boolean @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, vehicleId])
  @@unique([driverId, inventoryItemId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([inventoryItemId])
}

model MaterialType {
  id             String  @id @default(cuid())
  materialNumber String? @unique
  name           String
  category       String?
  unit           String  @default("t")
  isActive       Boolean @default(true)
  notes          String?

  truckLongHaulEntries    TruckLongHaulEntry[]
  asphaltTackCoatEntries  AsphaltDispatchEntry[]
  tackCoatLoadAllocations TackCoatLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AsphaltMixType {
  id        String  @id @default(cuid())
  mixNumber String  @unique
  name      String
  shortName String?
  unit      String  @default("t")
  category  String?
  plant     String?
  isActive  Boolean @default(true)
  notes     String?

  asphaltDispatchEntries AsphaltDispatchEntry[]
  asphaltLoadAllocations AsphaltLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConcreteType {
  id            String  @id @default(cuid())
  typeNumber    String  @unique
  name          String
  strengthClass String?
  exposureClass String?
  aggregate     String?
  consistency   String?
  unit          String  @default("m3")
  isActive      Boolean @default(true)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminOption {
  id        String  @id @default(cuid())
  groupKey  String
  value     String
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupKey, value])
  @@index([groupKey])
}

model AsphaltDispatchEntry {
  id String @id @default(cuid())

  workDate DateTime
  crew     String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber       String  @default("")
  projectName         String  @default("")
  constructionManager String?

  asphaltMixTypeId       String?
  asphaltMixType         AsphaltMixType? @relation(fields: [asphaltMixTypeId], references: [id], onDelete: SetNull)
  asphaltInventoryItemId String?

  asphaltMixNumber String?
  asphaltMixName   String?

  quantityTons Float @default(0)

  tackCoatMaterialTypeId  String?
  tackCoatMaterialType    MaterialType? @relation(fields: [tackCoatMaterialTypeId], references: [id], onDelete: SetNull)
  tackCoatInventoryItemId String?
  tackCoatMaterialName    String?
  tackCoatQuantity        Float         @default(0)
  tackCoatUnit            String?

  isForeignMix Boolean @default(false)

  notes String?

  truckLongHaulEntries    TruckLongHaulEntry[]
  asphaltLoadAllocations  AsphaltLoadAllocation[]
  tackCoatLoadAllocations TackCoatLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([crew])
  @@index([projectId])
  @@index([asphaltMixTypeId])
  @@index([asphaltInventoryItemId])
  @@index([tackCoatMaterialTypeId])
  @@index([tackCoatInventoryItemId])
}

model TruckLongHaulEntry {
  id String @id @default(cuid())

  workDate       DateTime
  assignmentType String   @default("CONSTRUCTION")
  asphaltCrew    String?

  asphaltDispatchEntryId String?
  asphaltDispatchEntry   AsphaltDispatchEntry? @relation(fields: [asphaltDispatchEntryId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber       String  @default("")
  projectName         String  @default("")
  constructionManager String?

  materialTypeId          String?
  materialType            MaterialType? @relation(fields: [materialTypeId], references: [id], onDelete: SetNull)
  materialInventoryItemId String?

  materialName     String?
  materialUnit     String?
  materialQuantity Float   @default(0)

  notes String?

  truckAssignments       TruckLongHaulTruckAssignment[]
  shortHaulAssignments   ShortHaulAssignment[]
  asphaltLoadAllocations AsphaltLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([assignmentType])
  @@index([asphaltCrew])
  @@index([asphaltDispatchEntryId])
  @@index([projectId])
  @@index([materialTypeId])
  @@index([materialInventoryItemId])
}

model TruckLongHaulTruckAssignment {
  id String @id @default(cuid())

  entryId String
  entry   TruckLongHaulEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  ownerType       String
  vehicleCategory String

  driverId   String?
  driver     Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverName String?

  vehicleId              String?
  vehicle                Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleInventoryItemId String?
  vehicleInventoryItem   InventoryItem? @relation(fields: [vehicleInventoryItemId], references: [id], onDelete: SetNull)
  vehicleNumber          String?
  licensePlate           String?
  vehicleType            String?

  subcontractorName String?
  notes             String?

  plannedTourCount   Int     @default(0)
  plannedTonsPerTour Float   @default(0)
  plannedTotalTons   Float   @default(0)
  plannedStartTime   String  @default("06:30")
  plannedEndTime     String  @default("17:00")
  plannedNotes       String?

  asphaltLoadAllocations AsphaltLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryId])
  @@index([ownerType])
  @@index([vehicleCategory])
  @@index([driverId])
  @@index([vehicleId])
  @@index([vehicleInventoryItemId])
}

model ShortHaulAssignment {
  id String @id @default(cuid())

  workDate  DateTime
  startTime String   @default("07:00")

  truckLongHaulEntryId String?
  truckLongHaulEntry   TruckLongHaulEntry? @relation(fields: [truckLongHaulEntryId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber String @default("")
  projectName   String @default("")

  vehicleId              String?
  vehicle                Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleInventoryItemId String?
  vehicleInventoryItem   InventoryItem? @relation(fields: [vehicleInventoryItemId], references: [id], onDelete: SetNull)

  vehicleNumber   String?
  licensePlate    String?
  vehicleType     String?
  vehicleCategory String?

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  driverName String?

  material String?
  notes    String?

  allowLongHaulConflict Boolean @default(false)
  conflictNote          String?

  tours                   ShortHaulTour[]
  asphaltLoadAllocations  AsphaltLoadAllocation[]
  tackCoatLoadAllocations TackCoatLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([truckLongHaulEntryId])
  @@index([projectId])
  @@index([vehicleId])
  @@index([vehicleInventoryItemId])
  @@index([driverId])
}

model ShortHaulTour {
  id String @id @default(cuid())

  assignmentId String
  assignment   ShortHaulAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  tourNumber Int    @default(1)
  startTime  String
  endTime    String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber String @default("")
  projectName   String @default("")

  purposeType   String  @default("CUSTOM")
  itemId        String?
  itemName      String?
  customPurpose String?

  quantity     Float?
  quantityUnit String?

  material String?
  notes    String?

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignmentId])
  @@index([projectId])
  @@index([purposeType])
  @@index([itemId])
  @@index([startTime])
  @@index([endTime])
}

model SpecialVehicleTask {
  id String @id @default(cuid())

  workDate DateTime

  vehicleId              String?
  vehicle                Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleInventoryItemId String?
  vehicleInventoryItem   InventoryItem? @relation(fields: [vehicleInventoryItemId], references: [id], onDelete: SetNull)

  vehicleName String
  taskText    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([vehicleId])
  @@index([vehicleInventoryItemId])
  @@index([vehicleName])
}

model SpecialVehicleDispatchAssignment {
  id String @id @default(cuid())

  workDate  DateTime
  startTime String   @default("07:00")
  endTime   String   @default("17:00")

  vehicleId              String?
