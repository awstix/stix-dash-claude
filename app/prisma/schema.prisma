generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ProjectStatus {
  NOT_STARTED
  ACTIVE
  PAUSED
  FINISHED
  CANCELLED
}

model CompanyInfo {
  id String @id @default("default")

  companyName      String
  legalName        String?
  street           String?
  postalCode       String?
  city             String?
  country          String?
  phone            String?
  mobile           String?
  email            String?
  website          String?
  instagramUrl     String?
  linkedinUrl      String?
  facebookUrl      String?
  youtubeUrl       String?
  tiktokUrl        String?
  managingDirector String?
  registryCourt    String?
  registryNumber   String?
  vatId            String?
  taxNumber        String?
  logoPublicUrl    String?
  logoStoragePath  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id                  String        @id @default(cuid())
  projectNumber       String        @unique
  name                String
  constructionManager String?
  plannedStart        DateTime?
  plannedEnd          DateTime?
  actualStart         DateTime?
  actualEnd           DateTime?
  status              ProjectStatus @default(NOT_STARTED)

  contractValueNet Int   @default(0)
  changeOrdersNet  Int   @default(0)
  progressPercent  Float @default(0)
  paymentsNet      Int   @default(0)

  siteAddress         String?
  mapLatitude         Float?
  mapLongitude        Float?
  mapZoom             Int?
  siteBoundaryGeoJson String?

  notes String?

  asphaltDispatchEntries            AsphaltDispatchEntry[]
  truckLongHaulEntries              TruckLongHaulEntry[]
  shortHaulAssignments              ShortHaulAssignment[]
  shortHaulTours                    ShortHaulTour[]
  asphaltLoadAllocations            AsphaltLoadAllocation[]
  tackCoatLoadAllocations           TackCoatLoadAllocation[]
  specialVehicleDispatchAssignments SpecialVehicleDispatchAssignment[]
  crewPlanningRows                  CrewPlanningRow[]
  equipmentDispatchAssignments      EquipmentDispatchAssignment[]
  weatherLogs                       ProjectWeatherLog[]
  dailyReports                      ProjectDailyReport[]
  photos                            ProjectPhoto[]
  projectNotes                      ProjectNote[]
  documentFolders                   ProjectDocumentFolder[]
  documents                         ProjectDocument[]
  formSubmissions                   ProjectFormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectNote {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  noteDate DateTime @default(now())
  category String   @default("GENERAL")
  title    String?
  content  String

  visibility           String  @default("INTERNAL")
  includeInDailyReport Boolean @default(true)
  createdByName        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([noteDate])
  @@index([category])
  @@index([includeInDailyReport])
  @@index([visibility])
}

model ProjectWeatherLog {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  weatherDate DateTime
  source      String   @default("OPEN_METEO")

  tempMinC                    Float?
  tempMaxC                    Float?
  precipitationMm             Float   @default(0)
  precipitationProbabilityMax Int?
  windSpeedMaxKmh             Float?
  weatherCode                 Int?
  weatherLabel                String?
  weatherCategory             String?
  weatherCategorySource       String  @default("AUTO")

  currentTemperatureC    Float?
  currentWeatherCode     Int?
  currentWeatherLabel    String?
  currentPrecipitationMm Float?
  currentWindSpeedKmh    Float?
  observedAt             DateTime?
  hourlyJson             String?

  fetchedAt DateTime @default(now())
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, weatherDate])
  @@index([projectId])
  @@index([weatherDate])
  @@index([weatherCategory])
}

model ProjectDailyReport {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  reportDate   DateTime
  reportNumber Int?
  status       String   @default("DRAFT")
  sheetNumber  String   @default("1")

  reportProjectName   String?
  reportProjectNumber String?
  weekdayLabel        String?

  weatherTempMinC              Float?
  weatherTempMaxC              Float?
  weatherCategory              String?
  weatherSource                String                    @default("AUTO")
  weatherNotes                 String?
  workStart                    String?
  workEnd                      String?
  trafficSafetyFirstCheckTime  String?
  trafficSafetySecondCheckTime String?
  laborJson                    String?
  subcontractorJson            String?
  machinesJson                 String?
  materialJson                 String?
  otherJson                    String?
  performanceJson              String?
  siteDiscussionNotes          String?
  siteDiscussionRolesJson      String?
  siteDiscussionThirdPartyName String?
  showRealMachineNames         Boolean                   @default(false)
  photoGridLayout              String                    @default("2x4")
  contractorSignatureDataUrl   String?
  clientSignatureDataUrl       String?
  approvedFieldsJson           String?
  approvedAt                   DateTime?
  approvedByName               String?
  photos                       ProjectDailyReportPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, reportDate])
  @@index([projectId])
  @@index([reportDate])
  @@index([reportNumber])
  @@index([status])
}

model ProjectPhoto {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fileName         String
  originalFileName String?
  publicUrl        String
  storagePath      String
  mimeType         String
  fileSizeBytes    Int
  imageWidth       Int?
  imageHeight      Int?

  notes                    String?
  metadataTaken            Boolean   @default(false)
  capturedAt               DateTime?
  cameraMake               String?
  cameraModel              String?
  gpsLatitude              Float?
  gpsLongitude             Float?
  gpsAddressLabel          String?
  gpsStreet                String?
  gpsHouseNumber           String?
  gpsPostcode              String?
  gpsCity                  String?
  gpsCountry               String?
  gpsReverseGeocodedAt     DateTime?
  gpsReverseGeocodeSource  String?
  gpsAddressJson           String?
  metadataJson             String?
  availableForDailyReports Boolean   @default(true)
  uploadedByUserId         String?
  uploadedByName           String?

  dailyReportLinks ProjectDailyReportPhoto[]

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@index([uploadedAt])
  @@index([capturedAt])
  @@index([gpsCity])
  @@index([uploadedByUserId])
  @@index([availableForDailyReports])
}

model ProjectDailyReportPhoto {
  id String @id @default(cuid())

  dailyReportId String
  dailyReport   ProjectDailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  photoId String
  photo   ProjectPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([dailyReportId, photoId])
  @@index([dailyReportId])
  @@index([photoId])
}

model ProjectDocumentFolder {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  documents ProjectDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([sortOrder])
}

model ProjectDocument {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  folderId String?
  folder   ProjectDocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  displayName      String
  fileName         String
  originalFileName String
  publicUrl        String
  storagePath      String
  mimeType         String
  fileSizeBytes    Int
  uploadedByUserId String?
  uploadedByName   String?

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@index([folderId])
  @@index([displayName])
  @@index([originalFileName])
  @@index([uploadedAt])
  @@index([uploadedByUserId])
}

model ProjectFormTemplate {
  id          String  @id @default(cuid())
  name        String
  category    String?
  description String?
  fieldsJson  String
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  paperSize   String  @default("A4")
  paperOrientation String @default("PORTRAIT")

  submissions ProjectFormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
  @@index([sortOrder])
}

model ProjectFormSubmission {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  templateId String?
  template   ProjectFormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  title                String
  formDate             DateTime?
  valuesJson           String
  templateSnapshotJson String?
  status               String    @default("DRAFT")
  createdByUserId      String?
  createdByName        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([templateId])
  @@index([formDate])
  @@index([status])
  @@index([createdAt])
}

model Driver {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  shortcut  String? @unique
  phone     String?
  isActive  Boolean @default(true)
  notes     String?

  shortHaulAssignments              ShortHaulAssignment[]
  vehicleAssignments                DriverVehicleAssignment[]
  truckLongHaulTruckAssignments     TruckLongHaulTruckAssignment[]
  asphaltLoadAllocations            AsphaltLoadAllocation[]
  tackCoatLoadAllocations           TackCoatLoadAllocation[]
  specialVehicleOperatorAssignments SpecialVehicleDispatchAssignment[] @relation("SpecialVehicleOperatorDriver")

  employee Employee? @relation("EmployeeDriver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id                      String  @id @default(cuid())
  vehicleNumber           String  @unique
  licensePlate            String? @unique
  vehicleType             String
  category                String
  isSpecialVehicle        Boolean @default(false)
  isActive                Boolean @default(true)
  notes                   String?
  dailyReportMachineLabel String?

  asphaltPayloadTons Float @default(0)
  tackCoatTankLiters Float @default(0)

  shortHaulAssignments               ShortHaulAssignment[]
  driverAssignments                  DriverVehicleAssignment[]
  truckLongHaulTruckAssignments      TruckLongHaulTruckAssignment[]
  specialVehicleTasks                SpecialVehicleTask[]
  specialVehicleDispatchAssignments  SpecialVehicleDispatchAssignment[] @relation("SpecialVehicleDispatchVehicle")
  specialVehicleTransportAssignments SpecialVehicleDispatchAssignment[] @relation("SpecialVehicleTransportVehicle")
  tours                              ShortHaulTour[]
  asphaltLoadAllocations             AsphaltLoadAllocation[]
  tackCoatLoadAllocations            TackCoatLoadAllocation[]
  crewDefaultVehicles                CrewDefaultVehicle[]
  crewPlanningAssignmentVehicles     CrewPlanningAssignmentVehicle[]
  equipmentDispatchAssignments       EquipmentDispatchAssignment[]
  workshopRepairOrders               WorkshopRepairOrder[]
  workshopFormSubmissions            WorkshopFormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dailyReportMachineLabel])
}

model WorkshopRepairOrder {
  id String @id @default(cuid())

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  vehicleNumber String?
  licensePlate  String?
  vehicleType   String?

  title       String
  description String?
  priority    String  @default("NORMAL")
  status      String  @default("OPEN")

  reportedAt   DateTime  @default(now())
  plannedStart DateTime?
  plannedEnd   DateTime?
  completedAt  DateTime?

  assignedTo String?
  notes      String?
  customValuesJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([priority])
  @@index([reportedAt])
  @@index([plannedStart])
  @@index([completedAt])
}

model WorkshopFormTemplate {
  id               String  @id @default(cuid())
  name             String
  category         String?
  description      String?
  fieldsJson       String
  isActive         Boolean @default(true)
  sortOrder        Int     @default(0)
  paperSize        String  @default("A4")
  paperOrientation String  @default("PORTRAIT")

  submissions WorkshopFormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model WorkshopFormSubmission {
  id String @id @default(cuid())

  templateId String?
  template   WorkshopFormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  templateKind         String
  title                String
  priority             String   @default("NORMAL")
  formDate             DateTime?
  valuesJson           String
  templateSnapshotJson String?
  createdByName        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([vehicleId])
  @@index([templateKind])
  @@index([priority])
  @@index([formDate])
  @@index([createdAt])
}

model DriverVehicleAssignment {
  id String @id @default(cuid())

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(true)
  isActive  Boolean @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, vehicleId])
  @@index([driverId])
  @@index([vehicleId])
}

model MaterialType {
  id             String  @id @default(cuid())
  materialNumber String? @unique
  name           String
  category       String?
  unit           String  @default("t")
  isActive       Boolean @default(true)
  notes          String?

  truckLongHaulEntries    TruckLongHaulEntry[]
  asphaltTackCoatEntries  AsphaltDispatchEntry[]
  tackCoatLoadAllocations TackCoatLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AsphaltMixType {
  id        String  @id @default(cuid())
  mixNumber String  @unique
  name      String
  shortName String?
  unit      String  @default("t")
  category  String?
  plant     String?
  isActive  Boolean @default(true)
  notes     String?

  asphaltDispatchEntries AsphaltDispatchEntry[]
  asphaltLoadAllocations AsphaltLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConcreteType {
  id            String  @id @default(cuid())
  typeNumber    String  @unique
  name          String
  strengthClass String?
  exposureClass String?
  aggregate     String?
  consistency   String?
  unit          String  @default("m3")
  isActive      Boolean @default(true)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminOption {
  id        String  @id @default(cuid())
  groupKey  String
  value     String
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupKey, value])
  @@index([groupKey])
}

model AsphaltDispatchEntry {
  id String @id @default(cuid())

  workDate DateTime
  crew     String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber       String  @default("")
  projectName         String  @default("")
  constructionManager String?

  asphaltMixTypeId String?
  asphaltMixType   AsphaltMixType? @relation(fields: [asphaltMixTypeId], references: [id], onDelete: SetNull)

  asphaltMixNumber String?
  asphaltMixName   String?

  quantityTons Float @default(0)

  tackCoatMaterialTypeId String?
  tackCoatMaterialType   MaterialType? @relation(fields: [tackCoatMaterialTypeId], references: [id], onDelete: SetNull)
  tackCoatMaterialName   String?
  tackCoatQuantity       Float         @default(0)
  tackCoatUnit           String?

  isForeignMix Boolean @default(false)

  notes String?

  truckLongHaulEntries    TruckLongHaulEntry[]
  asphaltLoadAllocations  AsphaltLoadAllocation[]
  tackCoatLoadAllocations TackCoatLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([crew])
  @@index([projectId])
  @@index([asphaltMixTypeId])
  @@index([tackCoatMaterialTypeId])
}

model TruckLongHaulEntry {
  id String @id @default(cuid())

  workDate       DateTime
  assignmentType String   @default("CONSTRUCTION")
  asphaltCrew    String?

  asphaltDispatchEntryId String?
  asphaltDispatchEntry   AsphaltDispatchEntry? @relation(fields: [asphaltDispatchEntryId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber       String  @default("")
  projectName         String  @default("")
  constructionManager String?

  materialTypeId String?
  materialType   MaterialType? @relation(fields: [materialTypeId], references: [id], onDelete: SetNull)

  materialName     String?
  materialUnit     String?
  materialQuantity Float   @default(0)

  notes String?

  truckAssignments       TruckLongHaulTruckAssignment[]
  shortHaulAssignments   ShortHaulAssignment[]
  asphaltLoadAllocations AsphaltLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([assignmentType])
  @@index([asphaltCrew])
  @@index([asphaltDispatchEntryId])
  @@index([projectId])
  @@index([materialTypeId])
}

model TruckLongHaulTruckAssignment {
  id String @id @default(cuid())

  entryId String
  entry   TruckLongHaulEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  ownerType       String
  vehicleCategory String

  driverId   String?
  driver     Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverName String?

  vehicleId     String?
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleNumber String?
  licensePlate  String?
  vehicleType   String?

  subcontractorName String?
  notes             String?

  plannedTourCount   Int     @default(0)
  plannedTonsPerTour Float   @default(0)
  plannedTotalTons   Float   @default(0)
  plannedStartTime   String  @default("06:30")
  plannedEndTime     String  @default("17:00")
  plannedNotes       String?

  asphaltLoadAllocations AsphaltLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryId])
  @@index([ownerType])
  @@index([vehicleCategory])
  @@index([driverId])
  @@index([vehicleId])
}

model ShortHaulAssignment {
  id String @id @default(cuid())

  workDate  DateTime
  startTime String   @default("07:00")

  truckLongHaulEntryId String?
  truckLongHaulEntry   TruckLongHaulEntry? @relation(fields: [truckLongHaulEntryId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber String @default("")
  projectName   String @default("")

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  vehicleNumber   String?
  licensePlate    String?
  vehicleType     String?
  vehicleCategory String?

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  driverName String?

  material String?
  notes    String?

  allowLongHaulConflict Boolean @default(false)
  conflictNote          String?

  tours                   ShortHaulTour[]
  asphaltLoadAllocations  AsphaltLoadAllocation[]
  tackCoatLoadAllocations TackCoatLoadAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([truckLongHaulEntryId])
  @@index([projectId])
  @@index([vehicleId])
  @@index([driverId])
}

model ShortHaulTour {
  id String @id @default(cuid())

  assignmentId String
  assignment   ShortHaulAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  tourNumber Int    @default(1)
  startTime  String
  endTime    String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber String @default("")
  projectName   String @default("")

  purposeType   String  @default("CUSTOM")
  itemId        String?
  itemName      String?
  customPurpose String?

  quantity     Float?
  quantityUnit String?

  material String?
  notes    String?

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignmentId])
  @@index([projectId])
  @@index([purposeType])
  @@index([itemId])
  @@index([startTime])
  @@index([endTime])
}

model SpecialVehicleTask {
  id String @id @default(cuid())

  workDate DateTime

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  vehicleName String
  taskText    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([vehicleId])
  @@index([vehicleName])
}

model SpecialVehicleDispatchAssignment {
  id String @id @default(cuid())

  workDate  DateTime
  startTime String   @default("07:00")
  endTime   String   @default("17:00")

  vehicleId String?
  vehicle   Vehicle? @relation("SpecialVehicleDispatchVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)

  vehicleName String @default("")

  transportVehicleId   String?
  transportVehicle     Vehicle? @relation("SpecialVehicleTransportVehicle", fields: [transportVehicleId], references: [id], onDelete: SetNull)
  transportVehicleName String?

  operatorDriverId   String?
  operatorDriver     Driver? @relation("SpecialVehicleOperatorDriver", fields: [operatorDriverId], references: [id], onDelete: SetNull)
  operatorDriverName String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber String @default("")
  projectName   String @default("")

  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: SetNull)

  crewName String?

  taskText String @default("")

  materialName String?
  quantity     Float?
  quantityUnit String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([vehicleId])
  @@index([transportVehicleId])
  @@index([operatorDriverId])
  @@index([projectId])
  @@index([crewId])
  @@index([startTime])
  @@index([endTime])
}

model AsphaltLoadAllocation {
  id String @id @default(cuid())

  workDate   DateTime
  sourceType String   @default("SHORT")

  asphaltDispatchEntryId String
  asphaltDispatchEntry   AsphaltDispatchEntry @relation(fields: [asphaltDispatchEntryId], references: [id], onDelete: Cascade)

  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectNumber String   @default("")
  projectName   String   @default("")

  asphaltMixTypeId String?
  asphaltMixType   AsphaltMixType? @relation(fields: [asphaltMixTypeId], references: [id], onDelete: SetNull)
  asphaltMixNumber String?
  asphaltMixName   String?

  shortHaulAssignmentId String?
  shortHaulAssignment   ShortHaulAssignment? @relation(fields: [shortHaulAssignmentId], references: [id], onDelete: Cascade)

  longHaulEntryId String?
  longHaulEntry   TruckLongHaulEntry? @relation(fields: [longHaulEntryId], references: [id], onDelete: Cascade)

  longHaulTruckAssignmentId String?
  longHaulTruckAssignment   TruckLongHaulTruckAssignment? @relation(fields: [longHaulTruckAssignmentId], references: [id], onDelete: Cascade)

  ownerType String @default("OWN")

  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleNumber   String?
  licensePlate    String?
  vehicleType     String?
  vehicleCategory String?

  driverId   String?
  driver     Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverName String?

  subcontractorName String?

  tourCount   Int   @default(1)
  tonsPerTour Float @default(0)
  totalTons   Float @default(0)

  startTime String @default("06:30")
  endTime   String @default("17:00")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([sourceType])
  @@index([asphaltDispatchEntryId])
  @@index([projectId])
  @@index([asphaltMixTypeId])
  @@index([shortHaulAssignmentId])
  @@index([longHaulEntryId])
  @@index([longHaulTruckAssignmentId])
  @@index([vehicleId])
  @@index([driverId])
}

model TackCoatLoadAllocation {
  id String @id @default(cuid())

  workDate   DateTime
  sourceType String   @default("SHORT")

  asphaltDispatchEntryId String?
  asphaltDispatchEntry   AsphaltDispatchEntry? @relation(fields: [asphaltDispatchEntryId], references: [id], onDelete: SetNull)

  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectNumber String   @default("")
  projectName   String   @default("")

  tackCoatMaterialTypeId String?
  tackCoatMaterialType   MaterialType? @relation(fields: [tackCoatMaterialTypeId], references: [id], onDelete: SetNull)
  materialName           String        @default("")
  quantityUnit           String        @default("l")

  shortHaulAssignmentId String?
  shortHaulAssignment   ShortHaulAssignment? @relation(fields: [shortHaulAssignmentId], references: [id], onDelete: Cascade)

  ownerType String @default("OWN")

  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleNumber   String?
  licensePlate    String?
  vehicleType     String?
  vehicleCategory String?

  driverId   String?
  driver     Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverName String?

  tourCount     Int   @default(1)
  litersPerTour Float @default(0)
  totalLiters   Float @default(0)

  startTime String @default("06:30")
  endTime   String @default("17:00")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
  @@index([sourceType])
  @@index([asphaltDispatchEntryId])
  @@index([projectId])
  @@index([tackCoatMaterialTypeId])
  @@index([shortHaulAssignmentId])
  @@index([vehicleId])
  @@index([driverId])
}

model Employee {
  id String @id @default(cuid())

  statusValue String @default("active")
  statusLabel String @default("Aktiv")

  entryDate DateTime?
  exitDate  DateTime?

  companyValue String?
  companyLabel String?

  departmentValue String?
  departmentLabel String?

  firstName String
  lastName  String

  isLeadership Boolean @default(false)

  birthDate   DateTime?
  genderValue String?
  genderLabel String?

  mobilePhone    String?
  emergencyPhone String?

  street     String?
  postalCode String?
  city       String?

  driverId String? @unique
  driver   Driver? @relation("EmployeeDriver", fields: [driverId], references: [id], onDelete: SetNull)

  positions              EmployeePositionAssignment[]
  qualifications         EmployeeQualification[]
  qualificationDocuments EmployeeQualificationDocument[]

  crewMemberships                 CrewMember[]
  crewPlanningAssignmentEmployees CrewPlanningAssignmentEmployee[]
  dispositionEntries              EmployeeDispositionEntry[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statusValue])
  @@index([companyValue])
  @@index([departmentValue])
  @@index([lastName])
  @@index([driverId])
}

model EmployeeDispositionEntry {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  startTime String @default("06:30")
  endTime   String @default("17:00")

  typeValue String
  typeLabel String

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([startDate])
  @@index([endDate])
  @@index([typeValue])
}

model EmployeePositionAssignment {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  positionValue String
  positionLabel String
  sortOrder     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, positionValue])
  @@index([employeeId])
  @@index([positionValue])
}

model EmployeeQualificationType {
  id String @id @default(cuid())

  name        String
  category    String  @default("OTHER")
  description String?

  reviewIntervalMonths Int     @default(6)
  isActive             Boolean @default(true)
  sortOrder            Int     @default(0)

  qualifications EmployeeQualification[]
  documents      EmployeeQualificationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
}

model EmployeeQualification {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  qualificationTypeId String
  qualificationType   EmployeeQualificationType @relation(fields: [qualificationTypeId], references: [id], onDelete: Cascade)

  lastReviewedAt DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, qualificationTypeId])
  @@index([employeeId])
  @@index([qualificationTypeId])
  @@index([lastReviewedAt])
}

model EmployeeQualificationDocument {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  qualificationTypeId String?
  qualificationType   EmployeeQualificationType? @relation(fields: [qualificationTypeId], references: [id], onDelete: SetNull)

  documentType     String @default("OTHER")
  displayName      String
  fileName         String
  originalFileName String
  publicUrl        String
  storagePath      String
  mimeType         String
  fileSizeBytes    Int

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([qualificationTypeId])
  @@index([documentType])
  @@index([uploadedAt])
}

model WorkTimePreset {
  id        String  @id @default(cuid())
  name      String
  startTime String  @default("06:30")
  endTime   String  @default("17:00")
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Crew {
  id String @id @default(cuid())

  name String

  typeValue String?
  typeLabel String?

  colorClass String?
  notes      String?

  isActive              Boolean @default(true)
  sortOrder             Int     @default(0)
  isAsphaltDispatchCrew Boolean @default(false)

  members                           CrewMember[]
  defaultVehicles                   CrewDefaultVehicle[]
  assignments                       CrewPlanningAssignment[]
  equipmentDispatchAssignments      EquipmentDispatchAssignment[]
  specialVehicleDispatchAssignments SpecialVehicleDispatchAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([typeValue])
  @@index([isActive])
}

model CrewMember {
  id String @id @default(cuid())

  crewId String
  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  roleText  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([crewId, employeeId])
  @@index([crewId])
  @@index([employeeId])
}

model CrewDefaultVehicle {
  id String @id @default(cuid())

  crewId String
  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  notes     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([crewId, vehicleId])
  @@index([crewId])
  @@index([vehicleId])
}

model EquipmentDispatchAssignment {
  id String @id @default(cuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: SetNull)

  startDate DateTime
  endDate   DateTime

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([projectId])
  @@index([crewId])
  @@index([startDate])
  @@index([endDate])
}

model CrewPlanningRow {
  id String @id @default(cuid())

  weekStart DateTime

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectNumber String @default("")
  projectName   String @default("")

  rowTitle String?
  notes    String?

  sortOrder Int @default(0)

  assignments CrewPlanningAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekStart])
  @@index([projectId])
  @@index([sortOrder])
}

model CrewPlanningAssignment {
  id String @id @default(cuid())

  rowId String
  row   CrewPlanningRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: SetNull)

  crewName      String  @default("")
  crewTypeValue String?
  crewTypeLabel String?

  startDate DateTime
  endDate   DateTime

  startTime String @default("06:30")
  endTime   String @default("17:00")

  notes String?

  extraEmployees CrewPlanningAssignmentEmployee[]
  extraVehicles  CrewPlanningAssignmentVehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rowId])
  @@index([crewId])
  @@index([startDate])
  @@index([endDate])
}

model CrewPlanningAssignmentEmployee {
  id String @id @default(cuid())

  assignmentId String
  assignment   CrewPlanningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  mode String @default("EXTRA")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, employeeId, mode])
  @@index([assignmentId])
  @@index([employeeId])
  @@index([mode])
}

model CrewPlanningAssignmentVehicle {
  id String @id @default(cuid())

  assignmentId String
  assignment   CrewPlanningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  mode String @default("EXTRA")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, vehicleId, mode])
  @@index([assignmentId])
  @@index([vehicleId])
  @@index([mode])
}
