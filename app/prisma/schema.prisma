  uploadedByName   String?

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([accidentReportId])
  @@index([uploadedAt])
}

model SafetyFormTemplate {
  id                  String  @id @default(cuid())
  name                String
  category            String?
  description         String?
  fieldsJson          String
  emailRecipientsJson String?
  isActive            Boolean @default(true)
  sortOrder           Int     @default(0)
  paperSize           String  @default("A4")
  paperOrientation    String  @default("PORTRAIT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
  @@index([sortOrder])
}

model SafetyInstructionTemplate {
  id String @id @default(cuid())

  folderId String?
  folder   SafetyTemplateFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  type           String
  title          String
  description    String?
  content        String?
  sectionsJson   String  @default("[]")
  sourcePdfPath  String?
  sourceDocxPath String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  records SafetyInstructionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([folderId])
  @@index([isActive])
  @@index([sortOrder])
}

model SafetyTemplateFolder {
  id String @id @default(cuid())

  area                  String
  name                  String
  systemKey             String? @unique
  isDeleted             Boolean @default(false)
  sortOrder             Int     @default(0)
  defaultValidityMonths Int?

  parentId String?
  parent   SafetyTemplateFolder?  @relation("SafetyTemplateFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children SafetyTemplateFolder[] @relation("SafetyTemplateFolderTree")

  templates SafetyInstructionTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area])
  @@index([parentId])
  @@index([sortOrder])
}

model SafetyInstructionRecord {
  id String @id @default(cuid())

  templateId String
  template   SafetyInstructionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  instructionDate     DateTime  @default(now())
  instructedByName    String?
  projectSnapshot     String?
  checkedSectionsJson String    @default("[]")
  notes               String?
  status              String    @default("DRAFT")
  archivedAt          DateTime?
  validityMonths      Int       @default(12)
  validUntil          DateTime?

  previousVersionId String?
  previousVersion   SafetyInstructionRecord?  @relation("SafetyInstructionRecordVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  newerVersions     SafetyInstructionRecord[] @relation("SafetyInstructionRecordVersions")

  signatures SafetyInstructionSignature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([projectId])
  @@index([instructionDate])
  @@index([status])
  @@index([archivedAt])
  @@index([previousVersionId])
  @@index([validUntil])
}

model SafetyInstructionSignature {
  id String @id @default(cuid())

  recordId String
  record   SafetyInstructionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  employeeName     String
  signatureDataUrl String?
  signedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recordId])
  @@index([employeeId])
  @@index([signedAt])
}

model SafetyHazardousSubstance {
  id String @id @default(cuid())

  templateRowId                   String?   @unique
  name                            String
  manufacturer                    String?
  category                        String?
  registerSection                 String    @default("HAZARDOUS")
  sequentialNumber                String?
  substanceType                   String?
  safetyDataSheetPresent          Boolean   @default(false)
  safetyDataSheetDate             DateTime?
  operatingInstructionPresent     Boolean   @default(false)
  operatingInstructionTemplateIds String?
  packageUnit                     String?
  quantity                        Float?
  repeatYears                     Int?
  repeatMonths                    Int?
  repeatDays                      Int?
  nextReviewDate                  DateTime?
  usageArea                       String?
  storagePlace                    String?
  signalWord                      String?
  hazardSymbols                   String?
  hStatements                     String?
  pStatements                     String?
  protectiveMeasures              String?
  firstAidMeasures                String?
  disposalNotes                   String?
  responsibleName                 String?
  isActive                        Boolean   @default(true)
  notes                           String?

